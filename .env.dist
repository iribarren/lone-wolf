# Lone Wolf — local environment template.
# Copy to `.env` and adjust; NEVER commit the real .env (secrets stay local).

# --- PostgreSQL (compose service) ---
POSTGRES_DB=lone_wolf
POSTGRES_USER=lone_wolf
POSTGRES_PASSWORD=change_me_local

# --- Symfony backend ---
APP_ENV=dev
APP_SECRET=change_me_dev_secret
# Backoffice account provisioned by `app:create-admin` (min 8-char password).
# Placeholders: change both before exposing this stack to anyone else.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin
# Composed inside docker-compose.yml from the PostgreSQL vars above;
# override here only for non-compose setups.
# DATABASE_URL=postgresql://lone_wolf:change_me_local@localhost:5432/lone_wolf?serverVersion=17&charset=utf8

# --- JWT (lexik/jwt-authentication-bundle, Phase 2) ---
JWT_PASSPHRASE=change_me_jwt

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
